# Nenyax — Docker Compose Environment Variables
#
# Copy to .env ONLY when running via docker-compose.
# For local dev (services outside Docker), no root .env is needed.
#
# Only POSTGRES_PASSWORD is required. Provider keys are set via dashboard.

# ── Required ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=nenyax

# ── Optional ─────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=a-long-random-string
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
