# Arkenos Caddyfile
#
# When ARKENOS_DOMAIN is set (e.g. arkenos.example.com):
#   Caddy auto-provisions HTTPS via Let's Encrypt.
#
# When no domain is set (IP-only access):
#   Caddy serves on :80 (HTTP only).
#
# The {$VAR:default} syntax uses the env var or falls back to the default.

{$ARKENOS_DOMAIN::80} {
	# Auth routes → frontend (Better Auth runs in Next.js)
	handle /api/auth/* {
		reverse_proxy frontend:3000
	}

	# LiveKit token route → frontend (Next.js API route)
	handle /api/livekit/* {
		reverse_proxy frontend:3000
	}

	# All other API requests → backend (FastAPI)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# WebSocket support
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# Everything else → frontend
	handle {
		reverse_proxy frontend:3000
	}
}
