# Arkenos Caddyfile (default: self-signed HTTPS for IP-only access)
# The install script overwrites this file when a domain is provided.

:443 {
	tls internal

	handle /api/auth/* {
		reverse_proxy frontend:3000
	}

	handle /api/livekit/* {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
