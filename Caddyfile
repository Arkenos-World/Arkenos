# Arkenos Caddyfile (default: self-signed HTTPS)
# The install script overwrites this with the correct config.

:443 {
	tls /certs/cert.pem /certs/key.pem

	handle /api/auth/* {
		reverse_proxy frontend:3000
	}

	handle /api/livekit/* {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
