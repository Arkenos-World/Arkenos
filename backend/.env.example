# Arkenos Backend — Environment Variables
#
# For local dev (DB + MinIO in Docker, backend local): NO .env file needed.
# All defaults in config.py match docker-compose port mappings.
#
# For Docker: docker-compose sets everything automatically.
#
# Only create a .env if you need to OVERRIDE a default:
#
# ── Defaults (no .env needed) ────────────────────────────────────────
# POSTGRES_PASSWORD=arkenos
# DB_HOST=localhost
# DB_PORT=5434              (docker-compose maps 5434→5432)
# MINIO_ENDPOINT=localhost:9002  (docker-compose maps 9002→9000)
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=arkenos
# PORT=8000
# DEBUG=true
# FRONTEND_URL=http://localhost:3000
#
# ── Provider keys (optional — dashboard takes priority) ──────────────
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
# GOOGLE_API_KEY=
# RESEMBLE_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ASSEMBLYAI_API_KEY=
# DEEPGRAM_API_KEY=
