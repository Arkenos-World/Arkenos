# Arkenos Frontend — Environment Variables
#
# For local dev: NO .env file needed.
# All defaults are hardcoded in auth.ts and api.ts.
#
# For Docker: docker-compose sets everything automatically.
#
# Only create a .env if you need to OVERRIDE a default:
#
# ── Defaults (no .env needed) ────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
# DATABASE_URL=postgresql://postgres:arkenos@localhost:5434/arkenos
# BETTER_AUTH_SECRET=arkenos-default-secret-change-in-production
# BETTER_AUTH_URL=http://localhost:3000
